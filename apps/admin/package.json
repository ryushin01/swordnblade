    "@snb/sword-art": "workspace:*",
    "@tanstack/react-query": "^5.106.1",
    "antd": "^6.7.0",
    "dayjs": "^1.11.23",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@feature-sliced/steiger-plugin": "^0.8.2",
