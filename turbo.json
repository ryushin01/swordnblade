{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "public/storybook/**"],
      "env": ["ADMIN_ORIGIN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:storybook": {
      "outputs": []
    }
  }
}
