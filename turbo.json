{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "storybook-static/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "outputs": [] },
    "typecheck": { "outputs": [] },
    "lint": { "outputs": [] },
    "e2e": { "dependsOn": ["build"], "cache": false }
  }
}
